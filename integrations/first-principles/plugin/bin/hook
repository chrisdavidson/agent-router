#!/usr/bin/env bash
# agent-router command hook for the first-principles integration.
# Hook JSON on stdin, hook JSON on stdout. Fails open: prints {} whenever it cannot route.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
integ="$(dirname "$(dirname "$here")")"   # integrations/first-principles
repo="$(dirname "$(dirname "$integ")")"
bin="${AGENT_ROUTER_BIN:-$repo/.venv/bin/agent-router}"
if [ ! -x "$bin" ]; then
  cat >/dev/null
  echo '{}'
  exit 0
fi
# shellcheck source=_failopen.sh
. "$here/_failopen.sh" 2>/dev/null || { cat >/dev/null; echo '{}'; exit 0; }
payload="$(cat)"
# Fast path: a main-thread Bash call has no eligible entry (the calculator is scoped to the
# integrated plugin's agent), so answer without starting Python.
# (A false match only means the full path runs; routing itself decides.)
bash_re='"tool_name"[[:space:]]*:[[:space:]]*"Bash"'
agent_re='"agent_type"[[:space:]]*:'
if [[ $payload =~ $bash_re ]] && ! [[ $payload =~ $agent_re ]]; then
  echo '{}'
  exit 0
fi
export AGENT_ROUTER_CATALOG="${AGENT_ROUTER_CATALOG:-$integ/catalog.yaml}"
export AGENT_ROUTER_CALIBRATION="${AGENT_ROUTER_CALIBRATION:-$integ/calibration.json}"
export AGENT_ROUTER_MODE=advisory
# Identity (agent type, report directory, command prefixes) is not typed here: with this set,
# `agent-router hook` resolves the plugin's published manifest (or the pinned fallback) and
# derives the catalog's targets and the default skip patterns from it. An explicit
# AGENT_ROUTER_SKIP_INPUT / AGENT_ROUTER_SKIP_PROMPT still wins. See ../../MANIFEST.md.
export AGENT_ROUTER_INTEGRATION="$integ"
export HF_HUB_DISABLE_PROGRESS_BARS=1
# Never `exec`: the answer is vetted (one JSON object, exit 0, within AGENT_ROUTER_HOOK_TIMEOUT)
# and replaced by {} otherwise. See _failopen.sh.
FAILOPEN_PY="${AGENT_ROUTER_PYTHON:-$(dirname "$bin")/python}"
fail_open_run "$bin" hook
