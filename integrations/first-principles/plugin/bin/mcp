#!/usr/bin/env bash
# agent-router stdio MCP server for the first-principles integration: the exact calculator
# only. Surfaces as mcp__plugin_agent-router-fp_agent_router__calc.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_resolve.sh
. "$here/_resolve.sh" || { echo "agent-router mcp: cannot load $here/_resolve.sh" >&2; exit 1; }
# AGENT_ROUTER_BIN, the checkout .venv, else `agent-router` on PATH. No fail-open here: an MCP
# server that cannot start must say so (stderr) and exit non-zero.
ar_resolve_bin || { echo "agent-router mcp: $AR_ERR" >&2; exit 1; }
exec "$AR_BIN" mcp --tools calc
